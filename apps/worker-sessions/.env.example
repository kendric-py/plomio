BASE_DEBUG=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Отдельный именованный Redis Stream на маркетплейс (sessions:ozon, sessions:wildberries) —
# не общий хардкод, т.к. в этом же Redis со временем появятся другие домены.
SESSIONS_STREAM_PREFIX=sessions
SESSIONS_STREAM_MAXLEN=1000

# Пусто по умолчанию — ручки выдачи прокси ещё нет, get_proxy() возвращает None.
PROXY_API_ISSUE_URL=
PROXY_API_TOKEN=
PROXY_API_TIMEOUT_SECONDS=60.0

GENERATION_CONCURRENCY_PER_MARKETPLACE=2
GENERATION_MAX_SESSIONS_PER_PROXY=20
GENERATION_TARGET_POOL_DEPTH=10
# false — только для локальной разработки без ручки выдачи прокси (см. PROXY_API_ISSUE_URL
# выше): генерирует сессии напрямую, без прокси. На реальных окружениях должно быть true —
# маркетплейсы быстро забанят IP, с которого идёт генерация сессий без прокси.
GENERATION_REQUIRE_PROXY=false
GENERATION_TTL_MS=420000
GENERATION_VALIDATION_TIMEOUT_SECONDS=15.0
GENERATION_BROWSER_ATTEMPT_TIMEOUT_S=120.0
GENERATION_NO_PROXY_RETRY_DELAY_SECONDS=30.0
GENERATION_POOL_FULL_RECHECK_DELAY_SECONDS=15.0

PROCESS_REAPER_SCAN_INTERVAL_S=60.0
PROCESS_REAPER_MAX_AGE_S=300.0
PROCESS_REAPER_SIGTERM_GRACE_S=5.0

SOCKS5_TUNNEL_MAX_GLOBAL_CONNECTIONS=512
SOCKS5_TUNNEL_MAX_PER_TUNNEL_CONNECTIONS=128

# Имя этого инстанса воркера — обязательно задаётся явно при деплое, не генерируется рантаймом.
LIVENESS_WORKER_NAME=worker-sessions-1
# Пусто по умолчанию — получателя heartbeat на бэкенде пока нет.
LIVENESS_ENDPOINT_URL=
LIVENESS_INTERVAL_SECONDS=15.0
LIVENESS_REQUEST_TIMEOUT_SECONDS=5.0
