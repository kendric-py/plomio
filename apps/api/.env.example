REST_APP_HOST=0.0.0.0
REST_APP_PORT=8000
REST_APP_TITLE=API
# Базовый URL фронтенда (без завершающего /) — используется для сборки ссылок на страницы задач/
# автоматизаций в payload уведомлений (см. packages/notifications/AGENTS.md). Пусто — ссылка в
# payload не кладётся (null).
REST_FRONTEND_BASE_URL=

AUTH_SECRET_KEY=
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=plomio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# M — как часто проверяем heartbeat воркеров (asyncio-таск на event loop apps/api, см.
# packages/cron/AGENTS.md). N — порог "пропущен heartbeat", должен быть заметно больше
# LIVENESS_INTERVAL_SECONDS воркеров (по умолчанию 15с у apps/worker_parser/apps/worker_sessions).
WORKER_HEALTH_SWEEP_INTERVAL_SECONDS=10.0
WORKER_HEALTH_MISSED_THRESHOLD_SECONDS=60.0

# Токен Telegram-бота (@BotFather). Пусто — отправка уведомлений и привязка Telegram выключены
# (см. packages/notifications/AGENTS.md, "Отправка"/"Привязка Telegram").
TELEGRAM_BOT_TOKEN=
# @username бота (без @) — только для сборки deep-link'а привязки, см. AGENTS.md.
TELEGRAM_BOT_USERNAME=
TELEGRAM_LINK_CODE_TTL_SECONDS=600

# Как часто и сколько PENDING notification_deliveries отправляем за один проход
# NOTIFICATION_DELIVERY_SWEEP (см. packages/notifications/AGENTS.md).
NOTIFICATIONS_DELIVERY_SWEEP_INTERVAL_SECONDS=10.0
NOTIFICATIONS_DELIVERY_SWEEP_BATCH_SIZE=50

# Direct-запросы (см. packages/direct/AGENTS.md). Сколько api ждёт ответ воркера; он же дедлайн
# запроса для воркера.
DIRECT_REQUEST_TIMEOUT_SECONDS=20.0
# Срок годности page_key, которым клиент листает страницы.
DIRECT_PAGE_KEY_TTL_SECONDS=900.0

# Биллинг (см. packages/billing/AGENTS.md). Сколько кредитов начисляется новому пользователю при
# регистрации; 0 — не начислять.
BILLING_SIGNUP_BONUS_CREDITS=0

# Прокси (см. packages/proxy/AGENTS.md). Общий секрет для GET /api/proxy/issue: воркер
# worker_sessions шлёт его в заголовке X-Worker-Token (PROXY_API_TOKEN в его .env). Пусто — выдача
# прокси выключена (503).
PROXY_WORKER_TOKEN=

# SOCKS5-прокси для запросов к Telegram Bot API (socks5://user:pass@host:port), если
# api.telegram.org недоступен напрямую. Пусто — без прокси.
TELEGRAM_PROXY_URL=
