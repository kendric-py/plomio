# M — как часто проверяем heartbeat воркеров (asyncio-таск на event loop apps/api, см.
# packages/cron/AGENTS.md). N — порог "пропущен heartbeat", должен быть заметно больше
# LIVENESS_INTERVAL_SECONDS воркеров (по умолчанию 15с у apps/worker_parser/apps/worker_sessions).
WORKER_HEALTH_SWEEP_INTERVAL_SECONDS=10.0
WORKER_HEALTH_MISSED_THRESHOLD_SECONDS=60.0
