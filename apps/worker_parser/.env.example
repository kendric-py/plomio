# Режим процесса: tasks — задачи из очереди Postgres; direct — синхронные запросы из Redis
# (Postgres в этом режиме не нужен). Один процесс — один режим.
WORKER_MODE=tasks
# Базовый URL фронтенда (без завершающего /) — ссылка на страницу задачи в уведомлении о её
# завершении. Пусто — ссылка в payload не кладётся (null).
FRONTEND_BASE_URL=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smpcrawl
POSTGRES_USER=
POSTGRES_PASSWORD=

POLL_WORKER_ID=
POLL_INTERVAL_SECONDS=5.0
POLL_LEASE_DURATION_SECONDS=120.0
POLL_HEARTBEAT_INTERVAL_SECONDS=30.0
POLL_STATUS_CHECK_INTERVAL_PAGES=1
POLL_MAX_CONCURRENT_TASKS=3
POLL_MAX_CONCURRENT_ITEMS_PER_TASK=5

SESSION_POOL_MAX_POP_ATTEMPTS=5
SESSION_POOL_MIN_TTL_MARGIN_SECONDS=30.0
SESSION_POOL_EMPTY_POOL_BACKOFF_SECONDS=5.0

HTTP_TIMEOUT_SECONDS=20.0
HTTP_RETRIES=3
HTTP_BASE_DELAY_SECONDS=1.5

# --- Режим direct (WORKER_MODE=direct) ---
# Имя consumer'а в группе direct-workers; у каждого процесса своё.
DIRECT_CONSUMER_NAME=direct-1
DIRECT_MAX_CONCURRENT_REQUESTS=20
# Сколько ждём новые запросы в XREADGROUP, мс.
DIRECT_BLOCK_MS=2000
# Общее число попыток на запрос (смена сессии между ними) в пределах его дедлайна.
DIRECT_MAX_ATTEMPTS=2
# Возраст горячей сессии до ротации. Не суммируется с SESSION_POOL_MIN_TTL_MARGIN_SECONDS.
DIRECT_HOT_SESSION_MAX_AGE_SECONDS=120.0
# Сколько ждём сессию из пула (не дольше остатка дедлайна), затем ответ unavailable.
DIRECT_SESSION_WAIT_SECONDS=3.0
# Маркетплейсы через запятую (ozon,wildberries); пусто — все.
DIRECT_MARKETPLACES=
# Размер страницы отзывов WB (WB отдаёт все отзывы одним ответом, страница — срез).
DIRECT_REVIEWS_WB_PAGE_SIZE=30

LIVENESS_WORKER_NAME=
LIVENESS_ENDPOINT_URL=
LIVENESS_INTERVAL_SECONDS=15.0
LIVENESS_REQUEST_TIMEOUT_SECONDS=5.0
